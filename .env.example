# Browser-safe Supabase project URL and anon/public key (Vite embeds VITE_* in browser bundle).
VITE_SUPABASE_URL=https://jefbqoimnzytamaaazjo.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key

# Server-only credentials. Configure these in Vercel Environment Variables; never expose or commit them.
SUPABASE_URL=https://jefbqoimnzytamaaazjo.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_secret

# Optional AI key for server-side generation. Users can also provide their own key in app settings.
GEMINI_API_KEY=
